menuconfig ESP_HOSTED
	bool "ESP-Hosted"
	default n if ESP_HOST_WIFI_ENABLED
	default n if ESP_WIFI_REMOTE_ENABLED && !ESP_WIFI_REMOTE_LIBRARY_HOSTED
	default y if ESP_WIFI_REMOTE_ENABLED && ESP_WIFI_REMOTE_LIBRARY_HOSTED
	default y

if ESP_HOSTED

	choice ESP_HOSTED_ROLE
		prompt "Use this device as (Coprocessor/Host)"
		default ESP_HOSTED_HOST
		help
			Select whether this build is for the host or the coprocessor.
			Hosted IDF apps almost always want the Host role; CP firmware
			projects set CONFIG_ESP_HOSTED_CP=y in their sdkconfig.defaults.

		config ESP_HOSTED_HOST
			bool "Host"

		config ESP_HOSTED_CP
			bool "Coprocessor (CP)"
	endchoice

	orsource "common/eh_common/Kconfig.ext"

	if ESP_HOSTED_CP
		orsource "coprocessor/Kconfig.ext"
	endif

	if ESP_HOSTED_HOST
		orsource "host/Kconfig.ext"
	endif

endif

# Component Manager reads sdkconfig.json. The USB stack symbols are omitted
# when the USB menu is inactive, and a hidden bool that is n is omitted too.
# These ints are written for every build, including when the value is 0.
config ESP_HOSTED_HOST_USB_CDC_ACM_MANIFEST
	int
	default 1 if ESP_HOSTED_HOST_USB_STACK_CDC_ACM && !ESP_HOSTED_HOST_USB_RNDIS
	default 0

config ESP_HOSTED_HOST_USB_RNDIS_MANIFEST
	int
	default 1 if ESP_HOSTED_HOST_USB_RNDIS
	default 0

config ESP_HOSTED_HOST_USB_CHERRYUSB_MANIFEST
	int
	default 1 if ESP_HOSTED_HOST_USB_STACK_CHERRYUSB
	default 0

config ESP_HOSTED_CP_TINYUSB_MANIFEST
	int
	default 1 if EH_TRANSPORT_CP_USB_OTG_DEVICE
	default 0
