# POC super CP: union of every emu-tested CP example's feature set
# (mcu_transport_config + ext_coex/api_exerciser + openthread/cli + peer_data).
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y

CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_eh_cp_ota_4m.csv"

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_NVS_ENABLED=y

# Wi-Fi + extensions
CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=y
CONFIG_ESP_WIFI_DPP_SUPPORT=y
CONFIG_ESP_HOSTED_CP_FEAT_WIFI_EXT_ITWT=y
CONFIG_ESP_HOSTED_CP_FEAT_WIFI_EXT_DPP=y
CONFIG_ESP_HOSTED_CP_FEAT_WIFI_EXT_ENT=y

# BLE controller over VHCI
CONFIG_ESP_HOSTED_CP_FEAT_BT=y
CONFIG_ESP_HOSTED_CP_BT_ENABLED=y
CONFIG_ESP_HOSTED_CP_FEAT_BT_HCI_VHCI=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y

# Misc RPC surfaces
CONFIG_ESP_HOSTED_CP_FEAT_PEER_DATA=y
CONFIG_ESP_HOSTED_CP_FEAT_GPIO_EXP=y
CONFIG_ESP_HOSTED_CP_FEAT_CLI=y
CONFIG_ESP_HOSTED_CP_FEAT_DEBUG=y
CONFIG_ESP_HOSTED_CP_FEAT_DEBUG_MEM_MONITOR=y
CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS=y

# External coex (legal with BT on SOC_EXTERNAL_COEX_ADVANCE chips, e.g. C5/C6)
CONFIG_ESP_HOSTED_CP_FEAT_CP_EXT_COEX=y
CONFIG_ESP_COEX_EXTERNAL_COEXIST_ENABLE=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# OpenThread RCP intentionally omitted: with it the image is 0x1c2610 B, 9.7 KB over the
# 0x1c0000 OTA slot (OT + 802.15.4 add ~67 KB), and its UART port clashes with hosted-UART.
CONFIG_ESP_HOSTED_CP_FEAT_RF_CERT=y
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
