menu "Test harness: CP deinit/init cycles"

config EH_TEST_CP_DEINIT_INIT_CYCLES
    int "deinit/init cycles to run on the cycles-start command"
    default 20
    range 0 1000
    help
        Run this many deinit and init cycles on a temporary task when the
        cycles-start console command arrives, printing free heap once per cycle
        at the same point. 0 compiles the cycles out.

endmenu
