menu "Common config (Host & Coprocessor)"
	depends on ESP_HOSTED

	config ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN
		bool "Start ESP-Hosted automatically"
		default y
		help
			y: ESP-Hosted starts by itself.
			Host: the first hosted call, for example esp_wifi_init(), starts
			the link and waits until it is up.
			Coprocessor: ESP-Hosted starts before app_main().

			n: the app calls esp_hosted_init() and
			esp_hosted_connect_to_slave().

endmenu
