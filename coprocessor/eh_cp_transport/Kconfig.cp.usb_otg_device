# Also enable the required TinyUSB Features
config TINYUSB_CDC_ENABLED
	bool
	default y if EH_TRANSPORT_CP_USB_OTG_DEVICE
	default n

menu "USB (OTG) Device Configuration (Experimental)"
	depends on EH_TRANSPORT_CP_USB_OTG_DEVICE

	config EH_TRANSPORT_CP_USB_OTG_DEVICE_TX_Q_SIZE
		int "Tx Queue Size"
		default 5

	config EH_TRANSPORT_CP_USB_OTG_DEVICE_RX_Q_SIZE
		int "Rx Queue Size"
		default 5

	config EH_TRANSPORT_CP_USB_OTG_DEVICE_CHECKSUM
		bool "Enable USB payload checksum"
		default y
		help
			16-bit sum over header+payload. The CP advertises
			ESP_CHECKSUM_ENABLED and the host mirrors it at runtime.

	config EH_TRANSPORT_CP_USB_OTG_DEVICE_RNDIS
		bool "Enable USB RNDIS network class"
		# Present, but not selectable until the RNDIS data plane is ready.
		depends on n
		default n
		help
			Composite device. CDC-ACM stays the control pipe (RPC, serial,
			HCI, and flow control). STA and AP Ethernet frames move to one
			RNDIS function. A received frame is AP when its source MAC is
			the SoftAP MAC, and STA otherwise.

			Do not also enable TinyUSB MSC, MTP, Vendor, or NCM. Those
			classes shift the default string table, which this descriptor
			indexes directly.

			The MCU host driver is still CDC-ACM only. Enabling this
			removes STA and AP data from the framed CDC stream.

			This selects TinyUSB network mode ECM/RNDIS when that choice
			has no saved value. If sdkconfig already has Network mode None,
			set it to ECM/RNDIS.

	# select/imply does not change a choice. This default is sourced before
	# esp_tinyusb's default of None, so it wins when the option is on and
	# the choice has no saved user selection.
	choice TINYUSB_NET_MODE
		default TINYUSB_NET_MODE_ECM_RNDIS if EH_TRANSPORT_CP_USB_OTG_DEVICE_RNDIS
	endchoice

endmenu
