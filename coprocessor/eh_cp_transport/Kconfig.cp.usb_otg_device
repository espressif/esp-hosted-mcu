# Also enable the required TinyUSB Features
config TINYUSB_CDC_ENABLED
	bool
	default y if EH_TRANSPORT_CP_USB_OTG_DEVICE
	default n

menu "USB (OTG) Device Configuration (Experimental)"
	depends on EH_TRANSPORT_CP_USB_OTG_DEVICE

	config EH_TRANSPORT_CP_USB_OTG_DEVICE_TX_Q_SIZE
		int "Tx Queue Size"
		default 5

	config EH_TRANSPORT_CP_USB_OTG_DEVICE_RX_Q_SIZE
		int "Rx Queue Size"
		default 5

	config EH_TRANSPORT_CP_USB_OTG_DEVICE_CHECKSUM
		bool "Enable USB payload checksum"
		default y
		help
			16-bit sum over header+payload. The CP advertises
			ESP_CHECKSUM_ENABLED and the host mirrors it at runtime.

	config EH_TRANSPORT_CP_USB_OTG_DEVICE_RNDIS
		bool "Enable USB RNDIS network class"
		default n
		help
			Composite device. CDC-ACM stays the control pipe (RPC, serial,
			HCI, and flow control). The active STA or SoftAP Ethernet frames
			move to one RNDIS function. The pipe carries one interface.
			WIFI_MODE_APSTA is not supported.

			Set TinyUSB network mode to ECM/RNDIS.

			Do not also enable TinyUSB MSC, MTP, Vendor, NCM, or a second
			CDC interface. Those classes shift the default string table,
			which this descriptor indexes directly.

			Enable ESP_HOSTED_HOST_USB_RNDIS on the host. Enabling this
			removes STA and AP data from the framed CDC stream.

			A saved sdkconfig that still has Network mode None will not
			build.

	if EH_TRANSPORT_CP_USB_OTG_DEVICE_RNDIS && !TINYUSB_NET_MODE_ECM_RNDIS
		comment "Select ECM/RNDIS:"
		comment "Component config"
		comment "└── TinyUSB Stack"
		comment "    └── Network driver (ECM/NCM/RNDIS)"
		comment "        └── Network mode ──> ECM/RNDIS"
	endif

endmenu
