menuconfig ESP_HOSTED_CP_FEAT_OPENTHREAD
	bool "OpenThread RCP (Radio Co-Processor)"
	depends on ESP_HOSTED_CP_FOR_MCU
	default n
	help
		Enable OpenThread RCP (Radio Co-Processor) support on this
		co-processor.  The coprocessor exposes its 802.15.4 radio to
		the host (typically an ESP32-P4) so the host can run a Thread
		stack — CLI, Border Router, etc.

		Spinel goes over the ESP-Hosted transport, as ESP_AUX_IF
		frames. No extra UART or pins are needed.

		Requires CONFIG_OPENTHREAD_ENABLED, CONFIG_OPENTHREAD_RADIO,
		CONFIG_OPENTHREAD_RCP_CUSTOM (the ESP-IDF OpenThread custom
		transport) and an SoC with IEEE 802.15.4 (C6 / H2 / H4 / C5).
		These are checked by ESP_HOSTED_CP_FEAT_OPENTHREAD_READY below;
		the feature TU only compiles when the gate is satisfied.

		For spinel on a dedicated UART, leave this off: the app starts
		the RCP itself, as ESP-IDF examples/openthread/ot_rcp does.

if ESP_HOSTED_CP_FEAT_OPENTHREAD

	# Dependency-checked readiness.  The CP feature CMakeLists + every
	# consumer use *_READY (not the menuconfig symbol) so an opt-in
	# without the matching IDF OpenThread Kconfig leaves a clear "off"
	# rather than a half-built feature.
	config ESP_HOSTED_CP_FEAT_OPENTHREAD_READY
		bool
		default y if OPENTHREAD_ENABLED && OPENTHREAD_RADIO && OPENTHREAD_RCP_CUSTOM && SOC_IEEE802154_SUPPORTED

	comment "⚠  Requires OPENTHREAD_ENABLED + OPENTHREAD_RADIO + OPENTHREAD_RCP_CUSTOM + SOC_IEEE802154_SUPPORTED"
		depends on !(OPENTHREAD_ENABLED && OPENTHREAD_RADIO && OPENTHREAD_RCP_CUSTOM && SOC_IEEE802154_SUPPORTED)

	config ESP_HOSTED_CP_FEAT_OPENTHREAD_AUTO_INIT
		bool "Auto-initialise OpenThread feature at boot"
		default y if ESP_HOSTED_CP_FEAT_OPENTHREAD_READY && ESP_HOSTED_CP_AUTO_FEAT_INIT
		default n
		depends on ESP_HOSTED_CP_AUTO_FEAT_INIT
		help
			When enabled, OpenThread feature advertises its
			capability bit at boot via eh_cp_init().  Per-RCP
			init/start happens on demand from host RPC.

	if !OPENTHREAD_RADIO
		comment "Radio Only Device must be selected:"
		comment "Component config"
		comment "└── OpenThread"
		comment "    └── Thread Core Features"
		comment "        └── Thread device type ──> Radio Only Device"
	endif
	if OPENTHREAD_COMMISSIONER
		comment "Disable Commissioner:"
		comment "Component config"
		comment "└── OpenThread"
		comment "    └── Thread Core Features"
		comment "        └── [ ] Enable Commissioner"
	endif
	if OPENTHREAD_JOINER
		comment "Disable Joiner:"
		comment "Component config"
		comment "└── OpenThread"
		comment "    └── Thread Core Features"
		comment "        └── [ ] Enable Joiner"
	endif
	if OPENTHREAD_SRP_CLIENT
		comment "Disable SRP Client:"
		comment "Component config"
		comment "└── OpenThread"
		comment "    └── Thread Core Features"
		comment "        └── [ ] Enable SRP Client"
	endif
	if OPENTHREAD_DNS_CLIENT
		comment "Disable DNS Client:"
		comment "Component config"
		comment "└── OpenThread"
		comment "    └── Thread Core Features"
		comment "        └── [ ] Enable DNS Client"
	endif
	config ESP_HOSTED_OT_HOSTED_RX_BUF_SIZE
		int "Spinel receive buffer size (bytes)"
		default 4096
		range 2048 32768
		help
			Buffer that holds spinel bytes from the host until the
			OpenThread task reads them. This RAM is allocated when the
			RCP starts. When the buffer is full, a received frame is
			dropped and OpenThread retries it.

	config ESP_HOSTED_OT_NETIF_QUEUE_SIZE
		int "OpenThread Network Interface Queue Size"
		default 10
		help
			The packet queue size for the OpenThread network interface

	config ESP_HOSTED_OT_TASK_QUEUE_SIZE
		int "OpenThread Task Queue Size"
		default 10
		help
			The OpenThread task queue size

endif # ESP_HOSTED_CP_FEAT_OPENTHREAD
