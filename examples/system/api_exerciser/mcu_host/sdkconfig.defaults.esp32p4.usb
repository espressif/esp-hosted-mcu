# Host is ESP32-P4, Coprocessor is ESP32-S31
CONFIG_IDF_TARGET="esp32p4"
CONFIG_SLAVE_IDF_TARGET_ESP32S31=y

# Select USB OTG Host as transport
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_OTG_HOST=y
# USB host stack. CDC-ACM uses the ESP-IDF USB Host Library and usb_host_cdc_acm
# (VID:PID from ESP_HOSTED_HOST_USB_VID / PID; 0 matches any).
CONFIG_ESP_HOSTED_HOST_USB_STACK_CDC_ACM=y
# CherryUSB uses the DWC2 host and its CDC-ACM driver. It opens /dev/ttyACM0,
# needs the CDC notification interrupt endpoint, and does not call usb_host_install().
# To select it, comment out the CDC-ACM line above and uncomment the next line.
# CONFIG_ESP_HOSTED_HOST_USB_STACK_CHERRYUSB=y
# -1: no GPIO wired to the co-processor EN/RST line
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=-1

# P4 USB OTG controller control-transfer size.
CONFIG_USBH_CDC_CONTROL_TRANSFER_BUFFER_SIZE=2048
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=2048
