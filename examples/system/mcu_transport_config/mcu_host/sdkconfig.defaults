# Manual (auto-init-off) full bring-up — HOST (MCU)
CONFIG_ESP_HOSTED=y

# The point of this example: the app owns every init call. Turn BOTH auto-inits
# off — the pre-app_main constructor AND the feature auto-init walk — so
# transport set_config runs before init and each feature is init'd explicitly.
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n
CONFIG_ESP_HOSTED_HOST_AUTO_FEAT_INIT=n

# Host features the app initialises manually (heartbeat needs RPC + RPC_EXT_V2).
CONFIG_ESP_HOSTED_HOST_FEAT_RPC=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC_EXT_V2=y
CONFIG_ESP_HOSTED_HOST_FEAT_SYSTEM=y
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y
CONFIG_ESP_HOSTED_HOST_FEAT_HEARTBEAT=y

# Transport = SDIO. The build default clock is 25000 kHz; main.c sets 20000, then 40000.
CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ=25000
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH=4

# Wi-Fi routed to the coprocessor. Pin the remote Wi-Fi profile to the iperf ESP32-P4
# reference (esp_wifi_remote WIFI_RMT_* knobs) so the host requests exactly what the
# CP is built for (CP esp32c6 ESP_WIFI_* matches these) — no re-init on wifi bring-up.
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y
CONFIG_WIFI_RMT_TX_BA_WIN=16
CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=y
CONFIG_WIFI_RMT_RX_BA_WIN=16

# NimBLE host; BLE controller runs on the coprocessor (no on-chip controller).
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_BT_NIMBLE_42_FEATURE_SUPPORT=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n

CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
