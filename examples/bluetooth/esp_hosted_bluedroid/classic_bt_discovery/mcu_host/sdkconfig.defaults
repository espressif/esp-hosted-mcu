# Role: HOST (MCU)
CONFIG_ESP_HOSTED=y

# Features: BT (Bluedroid + Classic enabled)
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y

# CP target: not set here. Classic BT needs an ESP32 or ESP32-S31 CP. Select it
# in Wi-Fi Remote -> choose slave target. On an ESP32-P4 host the default is C6,
# which has no Classic BT, so the build stops with an error.

# Transport: MCU default

CONFIG_FREERTOS_HZ=1000

# Bluedroid with Classic BT (BR/EDR): needs an ESP32 or ESP32-S31 CP.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
# Bluedroid stack-mode hint — drives BR/EDR feature gates even with local controller disabled.
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=y

# Wi-Fi Remote (typically required alongside Hosted)
