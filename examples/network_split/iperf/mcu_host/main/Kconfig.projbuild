menu "ESP-Hosted Example Config"
	choice EXAMPLE_APP_STA_NETIF
		prompt "When the app creates WIFI_STA_DEF (relative to esp_hosted_init)"
		default EXAMPLE_APP_STA_NETIF_BEFORE_HOSTED_INIT
		help
			The app creates WIFI_STA_DEF before or after esp_hosted_init(), or
			not at all.

		config EXAMPLE_APP_STA_NETIF_BEFORE_HOSTED_INIT
			bool "Before esp_hosted_init()"
		config EXAMPLE_APP_STA_NETIF_AFTER_HOSTED_INIT
			bool "After esp_hosted_init()"
		config EXAMPLE_APP_STA_NETIF_NONE
			bool "Never"
	endchoice

	choice EXAMPLE_BOOT_WIFI
		prompt "Test hook: Wi-Fi calls the app makes at boot"
		default EXAMPLE_BOOT_WIFI_INIT_START
		help
			Test use: an app that makes fewer Wi-Fi calls at boot. The console's
			wifi commands do the rest.

		config EXAMPLE_BOOT_WIFI_INIT_START
			bool "esp_wifi_init + esp_wifi_start"
		config EXAMPLE_BOOT_WIFI_INIT
			bool "esp_wifi_init only"
		config EXAMPLE_BOOT_WIFI_NONE
			bool "None"
	endchoice

	config EXAMPLE_NW_SPLIT_ECHO_SERVER
		bool "Run a TCP echo server on the host stack (network-split routing test)"
		default n
		help
			Start a TCP echo server on the host stack at ECHO_PORT (a host
			port-range port). A client reaching it proves the 802.3 split routed
			that port class to the host; CP-local ports go to the coprocessor.
			Off by default — enabled by the network-split routing test.

	config EXAMPLE_NW_SPLIT_ECHO_PORT
		int "Host echo server TCP port"
		depends on EXAMPLE_NW_SPLIT_ECHO_SERVER
		default 49999
		help
			Must lie in the host port range (49152-61439) so the split routes it
			to the host stack.

	menu "Example to run"
		depends on ESP_HOSTED_CP_EXT_NW_SPLIT

		config ESP_HOSTED_CP_EXAMPLE_MQTT_CLIENT
			bool "MQTT client example"
			default n

		menu "MQTT client config"
			depends on ESP_HOSTED_CP_EXAMPLE_MQTT_CLIENT

			choice BROKER_CHOICE
				prompt "MQTT Broker"
				default BROKER_HIVEMQ

				config BROKER_ECLIPSEPROJECTS
					bool "mqtt.eclipseprojects.io"
				config BROKER_HIVEMQ
					bool "broker.hivemq.com"
			endchoice

			config BROKER_URL
				string
				default "mqtt://mqtt.eclipseprojects.io" if BROKER_ECLIPSEPROJECTS
				default "mqtt://broker.hivemq.com" if BROKER_HIVEMQ
				help
					URL of the broker to connect to

			config BROKER_URL_FROM_STDIN
				bool
				default y if BROKER_URL = "FROM_STDIN"

		endmenu

		config ESP_HOSTED_CP_EXAMPLE_HTTP_CLIENT
			bool "HTTP client example"
			default n

		menu "HTTP client config"
			depends on ESP_HOSTED_CP_EXAMPLE_HTTP_CLIENT

			config HTTP_WEBSERVER
				string "HTTP webserver to send req"
				default "example.com"

			config HTTP_WEBSERVER_PORT
				string "HTTP webserver port"
				default "80"

			config HTTP_WEBSERVER_PATH
				string "HTTP webserver path"
				default "/"

			config HTTP_REQ_DELAY
				int "Delay after every http request (seconds)"
				default 10

		endmenu
	endmenu
endmenu
