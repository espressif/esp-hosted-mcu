menu "Example Configuration"

	config EXAMPLE_VALIDATION_CYCLES
		int "Validation cycle count"
		range 1 20
		default 2
		help
			Number of explicit init/connect/deinit cycles to execute.

	config EXAMPLE_CONNECT_TIMEOUT_MS
		int "Connect wait timeout (ms)"
		range 1000 60000
		default 12000
		help
			Maximum time to wait for both CP_INIT and TRANSPORT_UP events.

	config EXAMPLE_CYCLE_DELAY_MS
		int "Delay between validation cycles (ms)"
		range 0 10000
		default 1000
		help
			Delay inserted after deinit before starting the next cycle.

	config EXAMPLE_QUERY_FW_VERSION
		bool "Query firmware version after connect"
		default y
		help
			Try the optional firmware-version RPC after transport comes up.
			Old factory slave firmware may not support it, which is logged as a warning only.

endmenu