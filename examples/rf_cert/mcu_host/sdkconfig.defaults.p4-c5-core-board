# ESP32-P4 + ESP32-C5 core board — host (P4) side.
CONFIG_ESP_HOSTED_P4_C5_CORE_BOARD=y
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# A pre-rev-3 ESP32-P4 tops out at 360 MHz; asking for 400 asserts in esp_clk_init.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=360
