menu "Example Configuration"
    choice EXAMPLE_SPINEL_LINK
        prompt "Spinel link to the RCP"
        default EXAMPLE_SPINEL_LINK_HOSTED
        help
            ESP-Hosted transport: spinel goes as ESP_AUX_IF frames on the ESP-Hosted bus.
            It needs the ESP-IDF OpenThread custom transport, ESP-IDF commit 8c87790e47
            (master and release/v6.2; not in v6.1 or older). Without it the build stops.
            Dedicated UART: standard OpenThread on two extra wires, any ESP-IDF.
        config EXAMPLE_SPINEL_LINK_HOSTED
            bool "ESP-Hosted transport (ESP_AUX_IF)"
        config EXAMPLE_SPINEL_LINK_UART
            bool "Dedicated UART"
    endchoice

    menu "Dedicated spinel UART"
        depends on OPENTHREAD_RADIO_SPINEL_UART

        config EXAMPLE_HOST_UART_PORT
            int "Host UART port to the RCP"
            range 0 2
            default 1

        config EXAMPLE_HOST_UART_TX_PIN
            int "Host TX pin -> RCP RX"
            range -1 63
            default -1
            help
                -1 means not set: the build then fails with a message.

        config EXAMPLE_HOST_UART_RX_PIN
            int "Host RX pin <- RCP TX"
            range -1 63
            default -1
            help
                -1 means not set: the build then fails with a message.

        config EXAMPLE_HOST_UART_BAUDRATE
            int "Spinel UART baud rate"
            default 460800
            help
                Must be the same as EXAMPLE_RCP_UART_BAUDRATE on the co-processor.

    endmenu

endmenu
