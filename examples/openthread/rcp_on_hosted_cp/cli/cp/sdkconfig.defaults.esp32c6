# 1. CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# 2. BT off
CONFIG_BT_ENABLED=n

# 3. Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_eh_cp_ota_4m.csv"

# 4. Transport — default SDIO for P4 dev board pairing.  Override in
#    sdkconfig.local for SPI / UART / SPI-HD.

# 5. Optimisations
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Spinel UART pins to the host, used only on the dedicated UART link.
CONFIG_EXAMPLE_RCP_UART_TX_PIN=21
CONFIG_EXAMPLE_RCP_UART_RX_PIN=20
