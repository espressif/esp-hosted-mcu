menu "OpenThread RCP Example"

    config EXAMPLE_RCP_UART_PIN_MANUAL
        bool "Configure RCP UART pin manually"
        default n
        help
            Select this to choose UART pin manually

    config EXAMPLE_RCP_UART_RX_PIN
        int "The number of RX pin"
        depends on EXAMPLE_RCP_UART_PIN_MANUAL
        default 4
        range 0 25

    config EXAMPLE_RCP_UART_TX_PIN
        int "The number of TX pin"
        depends on EXAMPLE_RCP_UART_PIN_MANUAL
        default 5
        range 0 25

endmenu
