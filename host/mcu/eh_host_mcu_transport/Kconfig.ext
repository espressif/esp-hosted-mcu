config ESP_HOSTED_HOST_TRANSPORT_MCU
	bool
	default y if ESP_HOSTED_HOST_TYPE_MCU
	default n
	depends on ESP_HOSTED_HOST

config ESP_HOSTED_HOST_TRANSPORT_MCU_READY
	bool
	default y if ESP_HOSTED_HOST_TRANSPORT_MCU

if ESP_HOSTED_HOST_TRANSPORT_MCU
	# y if SDIO is available for the (host SoC, CP target) pair.
	config ESP_HOSTED_HOST_PRIV_SDIO_OPTION
		bool
		default y if (IDF_TARGET_ESP32 || IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && (ESP_HOSTED_CP_TARGET_ESP32 || ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C6 || ESP_HOSTED_CP_TARGET_ESP32C61)
		default n

	# y if USB OTG is available for the (host SoC, CP target) pair.
	# warning: verify that the SOC has enough USB endpoints to support the following
	# combination before enabling as a USB OTG Host or Device:
	# - USB-CDC-ACM
	# - USB-BTH
	# - USB-Networking (RNDIS/ECM/NCM)
	# Currently, only the P4 and S31 have enough USB endpoints for this combination.
	# S2 and S3 are enabled ONLY for USB OTG testing purposes.
	config ESP_HOSTED_HOST_PRIV_USB_OTG_OPTION
		bool
		default y if (IDF_TARGET_ESP32P4) && (ESP_HOSTED_CP_TARGET_ESP32S31 || ESP_HOSTED_CP_TARGET_ESP32S2 || ESP_HOSTED_CP_TARGET_ESP32S3)
		default n

	choice ESP_HOSTED_HOST_TRANSPORT_BUS
		prompt "Communication bus (co-processor <== bus ==> host)"
		default ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO if ESP_HOSTED_HOST_PRIV_SDIO_OPTION
		default ESP_HOSTED_HOST_TRANSPORT_BUS_SPI
		help
		  Selects which bus peripheral drives the host→CP link.
		  Pin / clock / baud defaults for the chosen bus live in the
		  corresponding Kconfig.host.<bus> sub-file.  SDIO is the
		  preferred default when both ends support it; falls back to
		  SPI Full-duplex otherwise.

		config ESP_HOSTED_HOST_TRANSPORT_BUS_SPI
			bool "SPI Full Duplex"
		config ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO
			bool "SDIO"
			depends on ESP_HOSTED_HOST_PRIV_SDIO_OPTION
		config ESP_HOSTED_HOST_TRANSPORT_BUS_SPI_HD
			bool "SPI Half Duplex"
		config ESP_HOSTED_HOST_TRANSPORT_BUS_UART
			bool "UART"
			# A flash-resident ISR stalls during flash ops and the 128-byte RX FIFO overflows.
			select UART_ISR_IN_IRAM if !RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH
		config ESP_HOSTED_HOST_TRANSPORT_BUS_OTG_HOST
			bool "USB (OTG) (as Host) (Experimental)"
			depends on ESP_HOSTED_HOST_PRIV_USB_OTG_OPTION
			help
				Host acts as USB OTG Host. ESP-Hosted frames, including RPC,
				are carried over CDC-ACM.

	endchoice

	# _READY = bus selected AND parent transport compiled-in. Gates source pulls.
	config ESP_HOSTED_HOST_TRANSPORT_BUS_SPI_READY
		bool
		default y if ESP_HOSTED_HOST_TRANSPORT_BUS_SPI && ESP_HOSTED_HOST_TRANSPORT_MCU_READY
	config ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO_READY
		bool
		default y if ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO && ESP_HOSTED_HOST_TRANSPORT_MCU_READY
	config ESP_HOSTED_HOST_TRANSPORT_BUS_SPI_HD_READY
		bool
		default y if ESP_HOSTED_HOST_TRANSPORT_BUS_SPI_HD && ESP_HOSTED_HOST_TRANSPORT_MCU_READY
	config ESP_HOSTED_HOST_TRANSPORT_BUS_UART_READY
		bool
		default y if ESP_HOSTED_HOST_TRANSPORT_BUS_UART && ESP_HOSTED_HOST_TRANSPORT_MCU_READY
	config ESP_HOSTED_HOST_TRANSPORT_BUS_OTG_HOST_READY
		bool
		default y if ESP_HOSTED_HOST_TRANSPORT_BUS_OTG_HOST && ESP_HOSTED_HOST_TRANSPORT_MCU_READY

	orsource "Kconfig.host.spi"
	orsource "Kconfig.host.sdio"
	orsource "Kconfig.host.spi_hd"
	orsource "Kconfig.host.uart"
	orsource "Kconfig.host.usb_otg_host"

	menu "Transport Test"
		config ESP_HOSTED_RAW_THROUGHPUT_TRANSPORT
			bool
			default y
			help
				RawTP support is always compiled in for MCU hosts. The test
				remains idle until the host CLI starts it at runtime; there is
				no boot-time auto-start direction.

		config ESP_HOSTED_RAW_TP_REPORT_INTERVAL
			int "RawTP: periodic duration to report stats accumulated"
			default 1

		config ESP_HOSTED_RAW_TP_HOST_TO_ESP_PKT_LEN
			int "RawTP: Host to ESP packet size"
			default 1460
	endmenu

	menu "Transport Debug"
		config ESP_HOSTED_HOST_PKT_STATS
			bool "Transport packet stats"
			depends on ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO || ESP_HOSTED_HOST_TRANSPORT_BUS_UART
			default n
			help
				Log the host datapath counters at regular intervals. The
				counters show TX in, out and discards, RX in and out, credit
				stalls.

				To find frame loss between the network stack and the CP,
				compare these counters with the CP packet stats.

				This option is a debug aid. Keep it disabled in production
				builds.

		config ESP_HOSTED_HOST_PKT_STATS_INTERVAL_SEC
			depends on ESP_HOSTED_HOST_PKT_STATS
			int "Packet stats reporting interval (sec)"
			default 30
	endmenu

endif
